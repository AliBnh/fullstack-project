{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(http_server_requests_seconds_count{application=\"automarket\"}[1m])", "legendFormat": "{{method}} {{uri}} {{status}}" }],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "title": "HTTP Response Time (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{application=\"automarket\"}[5m]))", "legendFormat": "p95 {{uri}}" }],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{application=\"automarket\",area=\"heap\"}", "legendFormat": "Used {{id}}" },
        { "expr": "jvm_memory_max_bytes{application=\"automarket\",area=\"heap\"}", "legendFormat": "Max {{id}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "title": "JVM Threads",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "jvm_threads_live_threads{application=\"automarket\"}", "legendFormat": "Live Threads" }],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
    },
    {
      "title": "JVM GC Pauses",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_sum{application=\"automarket\"}[1m])", "legendFormat": "{{action}} {{cause}}" }],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "title": "HTTP Errors (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count{application=\"automarket\",status=~\"4..\"}[1m])", "legendFormat": "4xx {{uri}}" },
        { "expr": "rate(http_server_requests_seconds_count{application=\"automarket\",status=~\"5..\"}[1m])", "legendFormat": "5xx {{uri}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
    },
    {
      "title": "DB Connection Pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "hikaricp_connections_active{application=\"automarket\"}", "legendFormat": "Active" },
        { "expr": "hikaricp_connections_idle{application=\"automarket\"}", "legendFormat": "Idle" },
        { "expr": "hikaricp_connections_max{application=\"automarket\"}", "legendFormat": "Max" }
      ],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
    },
    {
      "title": "System CPU Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [{ "expr": "system_cpu_usage{application=\"automarket\"}", "legendFormat": "CPU" }],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":0.6},{"color":"red","value":0.85}] } }, "overrides": [] }
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "targets": [{ "expr": "process_uptime_seconds{application=\"automarket\"}", "legendFormat": "Uptime" }],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "title": "Disk Space",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "targets": [{ "expr": "1 - (disk_free_bytes{application=\"automarket\"} / disk_total_bytes{application=\"automarket\"})", "legendFormat": "Used" }],
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":0.7},{"color":"red","value":0.9}] } }, "overrides": [] }
    }
  ],
  "schemaVersion": 39,
  "tags": ["automarket", "spring-boot"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "AutoMarket - Application Monitoring",
  "uid": "automarket-main",
  "version": 1
